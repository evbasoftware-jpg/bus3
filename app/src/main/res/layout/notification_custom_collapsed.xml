<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_collapsed_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚌 বাস লাইভ লোকেশন"
            android:textColor="#212121"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_collapsed_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 0 KM/H"
            android:textColor="#555555"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3 Theme Cards Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- বর্তমান স্টপেজ: উজ্জ্বল কমলা থিম কার্ড -->
        <LinearLayout
            android:id="@+id/card_collapsed_current"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_notification_card_orange"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/tv_collapsed_cur_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 বর্তমান স্টপ"
                android:textColor="#bf360c"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_collapsed_cur_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--"
                android:textColor="#bf360c"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- ⏩ পরবর্তী স্টপেজ: আকর্ষণীয় আকাশী নীল থিম কার্ড -->
        <LinearLayout
            android:id="@+id/card_collapsed_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_notification_card_blue"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/tv_collapsed_next_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⏩ পরবর্তী স্টপ"
                android:textColor="#0d47a1"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_collapsed_next_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--"
                android:textColor="#0d47a1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 🎯 গন্তব্য: রাজকীয় বেগুনী থিম কার্ড -->
        <LinearLayout
            android:id="@+id/card_collapsed_dest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_notification_card_purple"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/tv_collapsed_dest_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 গন্তব্য"
                android:textColor="#6a1b9a"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_collapsed_dest_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--"
                android:textColor="#4a148c"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
