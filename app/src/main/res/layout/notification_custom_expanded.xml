<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header Row: Bus Name & Stop Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_expanded_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚌 বাস লাইভ লোকেশন"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btn_expanded_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notification_btn_stop"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="⛔ ট্র্যাকিং বন্ধ"
            android:textColor="#c62828"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 1. বর্তমান স্টপেজ: উজ্জ্বল কমলা (Orange) থিম কার্ড -->
    <LinearLayout
        android:id="@+id/card_expanded_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_notification_card_orange"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tv_expanded_cur_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 বর্তমান স্টপেজ"
            android:textColor="#bf360c"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_expanded_cur_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="তথ্য লোড হচ্ছে..."
            android:textColor="#bf360c"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 2. ⏩ পরবর্তী স্টপেজ: আকর্ষণীয় আকাশী নীল (Ocean Sky Blue) থিম কার্ড -->
    <LinearLayout
        android:id="@+id/card_expanded_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_notification_card_blue"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tv_expanded_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏩ পরবর্তী স্টপেজ"
            android:textColor="#0d47a1"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_expanded_next_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="তথ্য লোড হচ্ছে..."
            android:textColor="#0d47a1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 3. 🎯 গন্তব্য: রাজকীয় বেগুনী (Royal Purple / Violet) থিম কার্ড -->
    <LinearLayout
        android:id="@+id/card_expanded_dest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_notification_card_purple"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tv_expanded_dest_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 গন্তব্য"
            android:textColor="#6a1b9a"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_expanded_dest_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="তথ্য লোড হচ্ছে..."
            android:textColor="#4a148c"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Footer: Speed & Update Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_expanded_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ গতি: 0 KM/H"
            android:textColor="#555555"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_expanded_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒 আপডেট: --"
            android:textColor="#555555"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
